# NVIDIA_API_KEY: Required for NVIDIA NIM API calls.
# Get your key from https://build.nvidia.com
NVIDIA_API_KEY="nvapi-YOUR_NVIDIA_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# USE_MOCK_LLM: Set to true to bypass LLM API calls and return realistic predefined data.
# This allows full end-to-end development without consuming API quotas.
USE_MOCK_LLM=false
